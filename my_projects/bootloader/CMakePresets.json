{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BOOT_FLASH_SELF_TEST": "OFF",
                "BOOT_FLASH_DESTRUCTIVE_TEST": "OFF",
                "BOOT_RAM_IMAGE_DIAGNOSTIC_LOG": "OFF"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "Debug-ATfE",
            "inherits": "default",
            "toolchainFile": "${sourceDir}/cmake/atfe.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release-ATfE",
            "inherits": "default",
            "toolchainFile": "${sourceDir}/cmake/atfe.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug-ATfE",
            "configurePreset": "Debug-ATfE"
        },
        {
            "name": "Release-ATfE",
            "configurePreset": "Release-ATfE"
        }
    ]
}
